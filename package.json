{
  "name": "smartfarm-web",
  "version": "0.1.0",
  "private": true,
  "description": "ICHU web application by SmartFarm: initial domain-oriented Angular scaffold.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SmartFarm-8733/WebFrontend-SmartFarm.git"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "build:compat": "ng run smartfarm-web:build-compat",
    "start:compat": "ng run smartfarm-web:serve-compat",
    "typecheck": "ngc -p tsconfig.check.json --noEmit",
    "test:e2e": "playwright test",
    "preview": "node scripts/preview.mjs",
    "preview:compat": "node scripts/preview.mjs --compat"
  },
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/material": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.2",
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@playwright/test": "1.64.0",
    "typescript": "6.0.3"
  }
}
