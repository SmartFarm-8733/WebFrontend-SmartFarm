{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "smartfarm-web": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "ichu",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "standalone": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/smartfarm-web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public",
                "ignore": [
                  "**/.gitkeep"
                ]
              }
            ],
            "styles": [
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "build-compat": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/smartfarm-web-compat",
            "index": "src/index.html",
            "main": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "aot": true,
            "assets": [{"glob": "**/*", "input": "public", "output": "/", "ignore": ["**/.gitkeep"]}],
            "styles": ["src/styles.scss"],
            "optimization": {"scripts": true, "styles": true, "fonts": false},
            "outputHashing": "all"
          }
        },
        "serve-compat": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {"buildTarget": "smartfarm-web:build-compat", "host": "127.0.0.1"}
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "smartfarm-web:build:production"
            },
            "development": {
              "buildTarget": "smartfarm-web:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
